{
  "name": "Leet Study 🎀",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "containerEnv": {
    "HOST": "0.0.0.0",
    "TZ": "America/Los_Angeles",
    "LEET_EDITOR": "code"
  },
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "Leet Study", "onAutoForward": "openBrowser" }
  },
  "postAttachCommand": { "study-app": "npm start" },
  "customizations": {
    "codespaces": { "openFiles": ["lessons/00-start-here.md"] },
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Default Light Modern",
        "editor.tabSize": 2,
        "files.autoSave": "afterDelay"
      }
    }
  }
}
